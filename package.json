{
  "name": "@hungnb94/jat",
  "version": "0.4.0",
  "description": "Download and upload Jira Cloud attachments with the API token kept in the OS credential store (macOS Keychain, Windows DPAPI, Linux Secret Service)",
  "type": "module",
  "bin": {
    "jat": "dist/bin.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "tsx --test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "jira",
    "atlassian",
    "attachments",
    "cli",
    "keychain",
    "dpapi",
    "secret-service",
    "claude-code"
  ],
  "author": "hungnb94",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hungnb94/jira-cli.git"
  },
  "homepage": "https://github.com/hungnb94/jira-cli#readme",
  "bugs": {
    "url": "https://github.com/hungnb94/jira-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
